<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mpc_control_py_ros2</name>
  <version>0.0.0</version>
  <description>Python-based MPC control package for AMENT build system</description>
  <maintainer email="johannes.waibel@epfl.ch">johannes</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>lar_msgs</exec_depend>
  <exec_depend>mpc_msgs_racing_ros2</exec_depend>
