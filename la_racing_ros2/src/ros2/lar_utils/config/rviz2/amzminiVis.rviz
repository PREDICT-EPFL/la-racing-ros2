Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Ground1/Offset1
        - /Environment1
        - /Environment1/Topic1
        - /Environment1/Namespaces1
        - /Trace1/Topic1
        - /Car1/Topic1
        - /Car1/Namespaces1
        - /MPC Trajectory1/Topic1
        - /MPC Trajectory1/Namespaces1
        - /Past Trajectory1/Topic1
        - /Past Trajectory1/Namespaces1
        - /Learning Data1/Namespaces1
        - /Velocity Profile1/Namespaces1
      Splitter Ratio: 0.6606786251068115
    Tree Height: 371
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.10000000149011612
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Ground
      Normal Cell Count: 0
      Offset:
        X: 0.5
        Y: 1
        Z: 0
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: false
      Length: 0.5
      Name: ENU frame
      Radius: 0.019999999552965164
      Reference Frame: enu
      Value: false
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.07999999821186066
      Name: Body frame
      Radius: 0.004999999888241291
      Reference Frame: body
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Environment
      Namespaces:
        track_centerline: true
        track_edges: true
        track_raceline: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vis/env
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: false
      Name: Trace
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vis/trace
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Car
      Namespaces:
        control: true
        mesh: true
        pos_ref: true
        velocity: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vis/car
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: MPC Trajectory
      Namespaces:
        path_param: true
        pos: true
        pos_err: true
        pose_points: true
        steering: true
        steering_defl: true
        throttle: true
        throttle_defl: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vis/mpc_traj
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Past Trajectory
      Namespaces:
        {}
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vis/past_traj
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Learning Data
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vis/learning_data
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Velocity Profile
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vis/vel_profile
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
